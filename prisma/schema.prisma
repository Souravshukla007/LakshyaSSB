// Lakshya SSB — Prisma Schema
// learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Plan {
  FREE
  PRO
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum RiskLevel {
  LOW
  MODERATE
  HIGH
}

enum OtpPurpose {
  LOGIN
  PASSWORD_RESET
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id                 String    @id @default(uuid())
  fullName           String
  email              String    @unique
  passwordHash       String?
  googleId           String?   @unique
  profileImageUrl    String?   @db.Text
  phone              String?
  targetEntry        String?
  attemptNumber      Int?
  preferredSSBCenter String?

  // Subscription (Razorpay)
  plan       Plan      @default(FREE)
  /// When the paid plan lapses. NULL = lifetime grant (e.g. medal redemption).
  /// Checked by lib/entitlement.ts, which is the only place allowed to decide
  /// whether a user is PRO.
  planExpiry DateTime?

  /// Bumped to invalidate every outstanding session JWT for this user
  /// (logout-all, password change, password reset, account delete).
  /// Compared against the token's claim in lib/auth.ts#getSession.
  tokenVersion Int @default(0)

  // Leaderboard & Medal System
  medals_total   Int       @default(0)
  medals_weekly  Int       @default(0)
  current_streak Int       @default(0)
  longest_streak Int       @default(0)
  last_login     DateTime?

  // Relations
  notifications    UserNotification[]
  payments         Payment[]
  medicalResults   MedicalResult[]
  piqSubmission    PiqSubmission?
  piqScores        PiqScore[]
  srtResults       SrtResult[]
  watResults       WatResult[]
  tatResults       TatResult[]
  practiceAttempts    PracticeAttempt[]
  freeEvalClaims      FreeEvalClaim[]
  oirQuestionHistory  OirQuestionHistory[]
  chatMessages       ChatMessage[]
  activityLogs       ActivityLog[]
  notificationPref   NotificationPref?
  feedbacks          Feedback[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([medals_total])
  @@index([medals_weekly])
  @@index([current_streak])
}

model UserNotification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("SYSTEM")
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Payment {
  id                String        @id @default(uuid())
  userId            String
  razorpayOrderId   String        @unique
  razorpayPaymentId String?
  amount            Int           // in paise (₹9 = 900)
  status            PaymentStatus @default(PENDING)
  createdAt         DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Medical Readiness Results
// ---------------------------------------------------------------------------

model MedicalResult {
  id             String    @id @default(uuid())
  userId         String

  // Raw inputs
  heightCm       Float
  weightKg       Float
  vision         String    // "6/6" | "correctable" | "none"
  flatFoot       Boolean   @default(false)
  colorBlind     Boolean   @default(false)
  surgeryHistory Boolean   @default(false)
  pushups        Int
  runMinutes     Float
  situps         Int

  // Computed scores (stored for history display)
  bmi            Float
  bmiScore       Int
  visionScore    Int
  conditionScore Int
  fitnessScore   Int
  medicalScore   Int
  riskLevel      RiskLevel

  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// PIQ Builder — Submission Inputs
// ---------------------------------------------------------------------------

model PiqSubmission {
  id        String   @id @default(uuid())
  userId    String   @unique

  // Leadership signals
  positionOfResponsibility Boolean @default(false)
  teamSportsYears          Int     @default(0)
  nccInvolvement           Boolean @default(false)
  sportsLevel              String  @default("none") // "none" | "school" | "district" | "state"

  // Initiative signals
  organizedEvent   Boolean @default(false)
  volunteerWork    Boolean @default(false)

  // Responsibility signals
  familyResponsibility Boolean @default(false)
  academicConsistency  Boolean @default(false)

  // Confidence signals
  publicSpeaking           Boolean @default(false)
  competitiveAchievements  Boolean @default(false)

  // Meta
  attemptNumber Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// PIQ Builder — Score History (one row per evaluation)
// ---------------------------------------------------------------------------

model PiqScore {
  id     String @id @default(uuid())
  userId String

  // OLQ sub-scores (0–10 each)
  leadership        Int
  initiative        Int
  responsibility    Int
  socialAdaptability Int
  confidence        Int
  consistency       Int

  // Computed totals
  totalScore Int
  riskLevel  RiskLevel

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// OTP Authentication
// ---------------------------------------------------------------------------

model Otp {
  id        String   @id @default(uuid())
  email     String
  /// SHA-256 of the code, not the code itself. A leaked database snapshot must
  /// not hand out working login/reset codes.
  otp       String
  /// What the code may be used for. Previously absent, which meant a code mailed
  /// for LOGIN was equally valid to RESET the password.
  purpose   OtpPurpose @default(LOGIN)
  /// Failed verification attempts. Enforces a cap instead of allowing an
  /// unlimited brute force of a 6-digit space.
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, purpose])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Situation Reaction Test (SRT) Evaluation Results
// ---------------------------------------------------------------------------

model SrtResult {
  id          String   @id @default(uuid())
  userId      String

  totalScore  Int
  themeScores Json
  riskLevel   RiskLevel

  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Word Association Test (WAT) Evaluation Results
// ---------------------------------------------------------------------------

model WatResult {
  id          String   @id @default(uuid())
  userId      String

  totalScore  Int
  themeScores Json
  riskLevel   RiskLevel

  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Thematic Apperception Test (TAT) Evaluation Results
// ---------------------------------------------------------------------------

model TatResult {
  id          String   @id @default(uuid())
  userId      String

  totalScore  Int
  themeScores Json
  riskLevel   RiskLevel

  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Practice Trial Tracking
// ---------------------------------------------------------------------------

model PracticeAttempt {
  id        String   @id @default(uuid())
  userId    String
  /// Either a module name ("OIR", "WAT", …) or a server-written completion
  /// marker ("WAT_EVAL"). Only the markers are authoritative — see
  /// lib/practice-limit.ts.
  module    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The actual query shape is `where: { userId, module }`; two single-column
  /// indexes forced Postgres to pick one and filter. Purely additive.
  @@index([userId, module])
}

/// The FREE-tier "one evaluation per module" ledger.
///
/// Deliberately a separate table from PracticeAttempt rather than a unique
/// constraint on it. PracticeAttempt already holds 320 legacy rows written by the
/// old client-driven quota POST — including 86 duplicate OIR rows for one user —
/// so adding `@@unique([userId, module])` there would have required deleting real
/// historical data to apply. This table starts empty, so the constraint is free.
///
/// The unique constraint IS the lock: lib/practice-limit.ts inserts first and
/// treats a P2002 violation as "already claimed", which closes the read-then-write
/// race where concurrent submissions each saw "no marker yet" and every one of
/// them was granted a free AI evaluation.
model FreeEvalClaim {
  id        String   @id @default(uuid())
  userId    String
  /// One of lib/practice-limit.ts GATED_MODULES: WAT, TAT, SRT, GPE, LECTURETTE, OIR.
  module    String
  claimedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Account Activity Log
// ---------------------------------------------------------------------------

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  action    String   // e.g. "LOGIN", "PROFILE_UPDATE", "PASSWORD_CHANGE", "AVATAR_UPLOAD"
  details   String   // Human-readable detail
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Notification Preferences
// ---------------------------------------------------------------------------

model NotificationPref {
  id           String  @id @default(uuid())
  userId       String  @unique
  loginAlerts  Boolean @default(true)
  weeklyDigest Boolean @default(true)
  promoEmails  Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Feedback Submissions
// ---------------------------------------------------------------------------

model Feedback {
  id          String   @id @default(uuid())
  userId      String?
  name        String?
  email       String?
  userType    String
  rating      Int
  features    String[]
  suggestion  String   @db.Text
  isAnonymous Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Current Affairs Storage
// ---------------------------------------------------------------------------

model CurrentAffair {
  id                 String   @id @default(uuid())
  title              String   @unique
  category           String
  date               String
  url                String?  @db.Text
  summary            String   @db.Text
  ssb_importance     String   @db.Text
  gd_topic           String   @db.Text
  lecturette         String   @db.Text
  interview_question String   @db.Text

  createdAt          DateTime @default(now())

  @@index([category])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// OIR Question History (Raw SQL fallback added to Schema to prevent drop)
// ---------------------------------------------------------------------------

model OirQuestionHistory {
  id          String   @id @default(dbgenerated("gen_random_uuid()::text"))
  userId      String
  questionKey String
  seenAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionKey], map: "OirQuestionHistory_user_question_unique")
  @@index([userId, seenAt], map: "OirQuestionHistory_user_seen_idx")
}

// ---------------------------------------------------------------------------
// Persistent Chat History
// ---------------------------------------------------------------------------

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String
  role      String   // "user" | "assistant"
  content   String   @db.Text
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
