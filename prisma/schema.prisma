// Lakshya SSB — Prisma Schema
// learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Plan {
  FREE
  PRO
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum RiskLevel {
  LOW
  MODERATE
  HIGH
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id                 String    @id @default(uuid())
  fullName           String
  email              String    @unique
  passwordHash       String?
  googleId           String?   @unique
  profileImageUrl    String?   @db.Text
  phone              String?
  targetEntry        String?
  attemptNumber      Int?
  preferredSSBCenter String?

  // Subscription (Razorpay)
  plan       Plan      @default(FREE)

  // Leaderboard & Medal System
  medals_total   Int       @default(0)
  medals_weekly  Int       @default(0)
  current_streak Int       @default(0)
  longest_streak Int       @default(0)
  last_login     DateTime?
  is_pro         Boolean   @default(false)

  // Relations
  payments       Payment[]
  medicalResults MedicalResult[]
  piqSubmission  PiqSubmission?
  piqScores      PiqScore[]
  srtResults     SrtResult[] // SRT history
  watResults     WatResult[] // WAT history
  tatResults     TatResult[] // TAT history
  practiceAttempts  PracticeAttempt[] // Track 1-free-test usages
  oirQuestionHistory OirQuestionHistory[] // OIR test tracking
  chatMessages     ChatMessage[] // Persistent AI conversations
  activityLogs     ActivityLog[]
  notificationPref NotificationPref?
  feedbacks        Feedback[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([medals_total])
  @@index([medals_weekly])
  @@index([current_streak])
}

model Payment {
  id                String        @id @default(uuid())
  userId            String
  razorpayOrderId   String        @unique
  razorpayPaymentId String?
  amount            Int           // in paise (₹49 = 4900)
  status            PaymentStatus @default(PENDING)
  createdAt         DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Medical Readiness Results
// ---------------------------------------------------------------------------

model MedicalResult {
  id             String    @id @default(uuid())
  userId         String

  // Raw inputs
  heightCm       Float
  weightKg       Float
  vision         String    // "6/6" | "correctable" | "none"
  flatFoot       Boolean   @default(false)
  colorBlind     Boolean   @default(false)
  surgeryHistory Boolean   @default(false)
  pushups        Int
  runMinutes     Float
  situps         Int

  // Computed scores (stored for history display)
  bmi            Float
  bmiScore       Int
  visionScore    Int
  conditionScore Int
  fitnessScore   Int
  medicalScore   Int
  riskLevel      RiskLevel

  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// PIQ Builder — Submission Inputs
// ---------------------------------------------------------------------------

model PiqSubmission {
  id        String   @id @default(uuid())
  userId    String   @unique

  // Leadership signals
  positionOfResponsibility Boolean @default(false)
  teamSportsYears          Int     @default(0)
  nccInvolvement           Boolean @default(false)
  sportsLevel              String  @default("none") // "none" | "school" | "district" | "state"

  // Initiative signals
  organizedEvent   Boolean @default(false)
  volunteerWork    Boolean @default(false)

  // Responsibility signals
  familyResponsibility Boolean @default(false)
  academicConsistency  Boolean @default(false)

  // Confidence signals
  publicSpeaking           Boolean @default(false)
  competitiveAchievements  Boolean @default(false)

  // Meta
  attemptNumber Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// PIQ Builder — Score History (one row per evaluation)
// ---------------------------------------------------------------------------

model PiqScore {
  id     String @id @default(uuid())
  userId String

  // OLQ sub-scores (0–10 each)
  leadership        Int
  initiative        Int
  responsibility    Int
  socialAdaptability Int
  confidence        Int
  consistency       Int

  // Computed totals
  totalScore Int
  riskLevel  RiskLevel

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// OTP Authentication
// ---------------------------------------------------------------------------

model Otp {
  id        String   @id @default(uuid())
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

// ---------------------------------------------------------------------------
// Situation Reaction Test (SRT) Evaluation Results
// ---------------------------------------------------------------------------

model SrtResult {
  id          String   @id @default(uuid())
  userId      String

  totalScore  Int
  themeScores Json
  riskLevel   RiskLevel

  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Word Association Test (WAT) Evaluation Results
// ---------------------------------------------------------------------------

model WatResult {
  id          String   @id @default(uuid())
  userId      String

  totalScore  Int
  themeScores Json
  riskLevel   RiskLevel

  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Thematic Apperception Test (TAT) Evaluation Results
// ---------------------------------------------------------------------------

model TatResult {
  id          String   @id @default(uuid())
  userId      String

  totalScore  Int
  themeScores Json
  riskLevel   RiskLevel

  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Practice Trial Tracking
// ---------------------------------------------------------------------------

model PracticeAttempt {
  id        String   @id @default(uuid())
  userId    String
  module    String   // e.g., "OIR", "WAT", "TAT", "SRT", "LECTURETTE"
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([module])
}

// ---------------------------------------------------------------------------
// Account Activity Log
// ---------------------------------------------------------------------------

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  action    String   // e.g. "LOGIN", "PROFILE_UPDATE", "PASSWORD_CHANGE", "AVATAR_UPLOAD"
  details   String   // Human-readable detail
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Notification Preferences
// ---------------------------------------------------------------------------

model NotificationPref {
  id           String  @id @default(uuid())
  userId       String  @unique
  loginAlerts  Boolean @default(true)
  weeklyDigest Boolean @default(true)
  promoEmails  Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Feedback Submissions
// ---------------------------------------------------------------------------

model Feedback {
  id          String   @id @default(uuid())
  userId      String?
  name        String?
  email       String?
  userType    String
  rating      Int
  features    String[]
  suggestion  String   @db.Text
  isAnonymous Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Current Affairs Storage
// ---------------------------------------------------------------------------

model CurrentAffair {
  id                 String   @id @default(uuid())
  title              String   @unique
  category           String
  date               String
  summary            String   @db.Text
  ssb_importance     String   @db.Text
  gd_topic           String   @db.Text
  lecturette         String   @db.Text
  interview_question String   @db.Text

  createdAt          DateTime @default(now())

  @@index([category])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// OIR Question History (Raw SQL fallback added to Schema to prevent drop)
// ---------------------------------------------------------------------------

model OirQuestionHistory {
  id          String   @id @default(dbgenerated("gen_random_uuid()::text"))
  userId      String
  questionKey String
  seenAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionKey], map: "OirQuestionHistory_user_question_unique")
  @@index([userId, seenAt], map: "OirQuestionHistory_user_seen_idx")
}

// ---------------------------------------------------------------------------
// Persistent Chat History
// ---------------------------------------------------------------------------

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String
  role      String   // "user" | "assistant"
  content   String   @db.Text
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
