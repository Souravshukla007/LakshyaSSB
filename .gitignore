# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz

# android build artifacts
android/.idea/
android/.gradle/
android/app/build/
android/build/

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# Backups written by scripts/migrate-avatars-to-blob.mjs. These contain the users'
# original base64 avatar images, so they must never be committed.
avatar-backup-*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
# NOTE: prisma/migrations is deliberately COMMITTED. It used to be ignored, which
# is why the project had no schema history and resorted to CREATE TABLE IF NOT
# EXISTS at runtime inside app/api/oir/generate. Migrations must be version
# controlled or `prisma migrate deploy` cannot reproduce production.

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
# Playwright MCP scratch output (page snapshots + console logs from agent runs).
# Can contain authenticated page content, so keep it out of version control.
/.playwright-mcp/

# audit / review write-ups
# Local-only. AUDIT_REPORT.md names internal file paths and records observations
# made directly against the PRODUCTION database (row counts, account states,
# stored avatar sizes). Useful to keep on disk, not something to publish.
/AUDIT_REPORT.md

# scratch command output
# Dumps left behind by local and agent runs: `git status` captures, tsc and
# ESLint logs, findstr probes, empty placeholder files. All disposable.
#
# Root-anchored on purpose. A bare `*.txt` would also swallow public/ads.txt,
# which AdSense requires and which must stay tracked. The leading slash limits
# this to the repository root, so nested .txt files are unaffected.
/*.txt

# custom admin scripts
scripts/upgrade-user.js
/Upgrade-to-Pro.md
/LakshyaSSB_TechStack_Interview_Guide.md
/Razorpay_Integration_Guide.md
/Saarathi_Finance_AppDev_Interview_Guide.md

# Firebase / Google secrets — NEVER commit these
google-services.json
GoogleService-Info.plist

# editor / AI assistant tooling and internal specs (kept local, not published)
.kiro/
.gemini/
.vscode/
skills/