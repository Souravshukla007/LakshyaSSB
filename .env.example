# Database connection string
# Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:password@localhost:5432/myportfolio?schema=public"

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Gemini API key (server-side only)
GEMINI_API_KEY=""

# Gemini model name. Optional — defaults to `gemini-flash-latest` (see
# lib/ai-eval.ts). Leave blank unless you need a pinned version for reproducible
# output. Google retires dated model names (gemini-1.5-flash and
# gemini-2.0-flash both started returning 404), which silently 500s every AI
# evaluation route, so prefer the moving `-latest` alias.
GEMINI_MODEL=""

# Resend Email API (for OTP and notifications)
RESEND_API_KEY=""

# JWT Secret for session signing.
# REQUIRED in every environment — lib/auth.ts throws at import time if this is
# missing or shorter than 32 bytes. There is deliberately no fallback value.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=""

# Vercel Blob — object storage for user avatars.
# REQUIRED for avatar upload to work. Without it /api/account/upload-avatar returns
# 503 rather than silently falling back to storing base64 in Postgres (which is the
# problem this replaced: avatars up to 1.98 MB per row forced /api/leaderboard to
# stop selecting the column, so every user except the caller lost their picture).
# Get it from: Vercel dashboard -> Storage -> create a Blob store -> .env.local tab.
# On Vercel this is injected automatically once the store is linked to the project.
BLOB_READ_WRITE_TOKEN=""

# Razorpay (for payments).
# The publishable key id is returned to the browser by /api/payment/create-order,
# so there is deliberately no NEXT_PUBLIC_ copy to drift out of sync.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Razorpay webhook signing secret. REQUIRED — without it /api/payment/webhook
# rejects every delivery, and a captured payment whose browser callback never
# fired (closed tab, lost connection, UPI app-switch that did not return) leaves
# the customer on FREE with no way for the system to notice.
# Set the same value in: Razorpay dashboard -> Settings -> Webhooks -> add
# {NEXT_PUBLIC_APP_URL}/api/payment/webhook, subscribed to at least
# `payment.captured` and `payment.failed`.
RAZORPAY_WEBHOOK_SECRET=""

# Cron Secret
CRON_SECRET=""

# GNews API (for current affairs)
GNEWS_API_KEY=""

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
# Android OAuth client ID, used by /api/auth/google/native to validate the `aud`
# claim of an ID token minted by the Capacitor Google Sign-In plugin. Leave blank
# if the Android client shares GOOGLE_CLIENT_ID — if it differs and this is unset,
# native sign-in fails closed with an audience mismatch.
GOOGLE_ANDROID_CLIENT_ID=""
