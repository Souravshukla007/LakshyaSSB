# Database connection string
# Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:password@localhost:5432/myportfolio?schema=public"

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Gemini API key (server-side only)
GEMINI_API_KEY=""

# Resend Email API (for OTP and notifications)
RESEND_API_KEY=""

# JWT Secret for session signing
JWT_SECRET=""

# Razorpay (for payments)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# Cron Secret
CRON_SECRET=""

# GNews API (for current affairs)
GNEWS_API_KEY=""

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
